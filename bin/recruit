#!/bin/sh
# recruit — hire an agent into its own herdr pane.
#
#   recruit <role> [task ...]                       hire into the role's default checkout
#   recruit <role> --worktree <branch> [task ...]   hire into a fresh git worktree
#   recruit <role> --worktree <branch> --repo <dir> [task ...]
#                                                   ... of a named repository
#   recruit --roles                                 list available agents
#
# Roles are native Claude Code agent definitions in ~/.claude/agents/<role>.md —
# the same files the Task tool uses for subagents. Their frontmatter owns the
# tools, model and description; this script only places them in a herdr pane.
#
#   <project>/.roster   optional "<role> <path-relative-to-project>" per line
#
# Each hire gets its own tab named <role>-<n>, so any number of agents coexist and
# stay visible in the herdr sidebar. Two writers on one checkout is not allowed —
# use --worktree for the second one.
#
# Every hire — with or without --worktree — lands in a tab of the project workspace.
# See the worktree section below for why the git checkout is made by git itself.

set -eu

AGENTS_DIR="${CLAUDE_AGENTS_DIR:-$HOME/.claude/agents}"
AGENT_KIND="${RECRUIT_AGENT:-claude}"
WORKTREE_DIR="${RECRUIT_WORKTREE_DIR:-$HOME/.herdr/worktrees}"

die() { echo "recruit: $*" >&2; exit 1; }

if [ "${1:-}" = "--roles" ]; then
    for f in "$AGENTS_DIR"/*.md; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .md)
        printf '%-24s %s\n' "$name" "$(sed -n 's/^description: //p' "$f" | cut -c1-80)"
    done
    exit 0
fi

role="${1:-}"
[ -n "$role" ] || die "usage: recruit <role> [--worktree <branch>] [--repo <dir>] [task ...]"
shift

worktree=""
repo_opt=""
while :; do
    case "${1:-}" in
        --worktree)
            shift
            worktree="${1:-}"
            [ -n "$worktree" ] || die "--worktree needs a branch name"
            shift
            ;;
        --repo)
            shift
            repo_opt="${1:-}"
            [ -n "$repo_opt" ] || die "--repo needs a directory"
            shift
            ;;
        *)
            break
            ;;
    esac
done
task="$*"

[ -n "$worktree" ] || [ -z "$repo_opt" ] || die "--repo only makes sense together with --worktree"

[ -f "$AGENTS_DIR/$role.md" ] || die "no agent $AGENTS_DIR/$role.md (see: recruit --roles)"

command -v herdr >/dev/null 2>&1 || die "herdr not on PATH"
herdr status server >/dev/null 2>&1 || die "herdr server is not running — start it with 'herdr'"

# --- locate the project root: nearest ancestor holding a .roster, else $PWD ------
project_root=$(
    dir=$PWD
    while [ "$dir" != "/" ]; do
        [ -f "$dir/.roster" ] && { echo "$dir"; exit 0; }
        dir=$(dirname "$dir")
    done
    echo "$PWD"
)
project_label=$(basename "$project_root")

# --- where this role works -----------------------------------------------------
role_cwd="$project_root"
if [ -f "$project_root/.roster" ]; then
    rel=$(awk -v r="$role" '$1==r {print $2; exit}' "$project_root/.roster")
    [ -n "$rel" ] && role_cwd="$project_root/$rel"
fi
[ -d "$role_cwd" ] || die "role directory does not exist: $role_cwd"
role_cwd=$(cd "$role_cwd" && pwd)  # normalise "project/." into "project"

# --- which repository a --worktree hire branches from --------------------------
# `.roster` maps a role to a directory, and that directory is not always a git
# checkout: on one project `reviewer .` points at a directory holding three
# repositories and being none of them itself. Every `recruit reviewer --worktree` there
# died with `not_git_worktree` (11.09.2026). Order of resolution: an explicit --repo wins;
# otherwise the role's own directory if it is a checkout; otherwise the single
# repository directly under the project root. Several candidates are never guessed
# between — the hire stops and asks for --repo.
resolve_repo() {
    if [ -n "$repo_opt" ]; then
        case "$repo_opt" in
            /*) candidate="$repo_opt" ;;
            *)  candidate="$project_root/$repo_opt" ;;
        esac
        [ -d "$candidate" ] || die "--repo: no such directory: $candidate"
        top=$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null || true)
        [ -n "$top" ] || die "--repo: $candidate is not a git repository"
        echo "$top"
        return 0
    fi

    top=$(git -C "$role_cwd" rev-parse --show-toplevel 2>/dev/null || true)
    if [ -n "$top" ]; then
        echo "$top"
        return 0
    fi

    found=""
    count=0
    for d in "$project_root"/*/; do
        [ -e "${d}.git" ] || continue
        count=$((count + 1))
        found="${d%/}"
        list="${list:-}${list:+, }$(basename "$found")"
    done
    [ "$count" -eq 1 ] || die "role directory $role_cwd is not a git checkout and $project_root holds $count repositories (${list:-none}) — name one: recruit $role --worktree $worktree --repo <dir>"
    echo "$found"
}

# --- read one field out of a herdr JSON reply ----------------------------------
field() {
    python3 -c '
import json, sys
data = json.load(sys.stdin)
if "error" in data:
    sys.exit("herdr error: %s" % data["error"])
node = data["result"]
for key in sys.argv[1:]:
    node = node[key]
print(node)
' "$@"
}

# --- next free name for this role ----------------------------------------------
# Recomputed on every start attempt: two recruits can run concurrently (e.g. two
# await-mr watchers firing in the same window) and would otherwise both claim -1.
next_name() {
    herdr agent list | python3 -c '
import json, sys
role = sys.argv[1]
agents = json.load(sys.stdin)["result"]["agents"]
used = []
for a in agents:
    name = a.get("name") or ""
    if name.startswith(role + "-"):
        tail = name[len(role) + 1:]
        if tail.isdigit():
            used.append(int(tail))
print("%s-%d" % (role, max(used) + 1 if used else 1))
' "$role"
}
name=$(next_name)

# --- find or create the project workspace --------------------------------------
ws=$(herdr workspace list | python3 -c '
import json, sys
label = sys.argv[1]
for w in json.load(sys.stdin)["result"]["workspaces"]:
    if w.get("label") == label:
        print(w["workspace_id"]); break
' "$project_label")
if [ -z "$ws" ]; then
    ws=$(herdr workspace create --cwd "$project_root" --label "$project_label" --focus | field workspace workspace_id)
    echo "workspace $project_label created ($ws)"
fi

# --- the checkout a --worktree hire works in -----------------------------------
# The checkout is made with plain `git worktree add`, not with `herdr worktree create`,
# and the pane is then an ordinary tab of the project workspace.
#
# Why not `herdr worktree create`: in herdr a worktree IS a workspace. The command always
# opens a new workspace and groups it with the repository's own workspace — "worktree
# create creates a Git worktree checkout, opens it as a workspace, and groups it with the
# parent repo workspace" (CLI reference, identical text in v0.7.5 and v0.9.0). There is no
# flag that puts the pane into an existing workspace: --workspace names the *source*
# repository, and passing it together with --cwd is a syntax error (exit 2, usage printed,
# same on 0.7.5 on 08.08.2026 and on 0.9.0 on 11.09.2026). Measured on 0.9.0 on 11.09.2026
# in a throwaway repo: one `worktree create --cwd <repo>` produced *two* new workspaces —
# the repo's parent workspace and the worktree's own — and neither was the project one.
# `--path` only chooses where the checkout lands on disk; the pane still got its own
# workspace. So the hire was never in the project workspace, on either version.
#
# `git worktree add` keeps the same layout herdr uses ($RECRUIT_WORKTREE_DIR/<repo>/<branch
# with / replaced by ->), so `herdr worktree list --cwd <repo>` still sees the checkout.
# Cleanup is git's: `git -C <repo> worktree remove <path>` (`herdr worktree remove` takes a
# worktree *workspace* id, and there is none any more).
if [ -n "$worktree" ]; then
    repo=$(resolve_repo) || exit 1
    slug=$(printf '%s' "$worktree" | tr '/' '-')
    wt_path="$WORKTREE_DIR/$(basename "$repo")/$slug"
    [ -e "$wt_path" ] && die "checkout already exists: $wt_path — reuse it, or drop it with 'git -C $repo worktree remove $wt_path'"
    mkdir -p "$(dirname "$wt_path")"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$worktree"; then
        git -C "$repo" worktree add "$wt_path" "$worktree" >/dev/null \
            || die "git worktree add failed for existing branch $worktree in $repo"
    else
        git -C "$repo" worktree add -b "$worktree" "$wt_path" >/dev/null \
            || die "git worktree add -b $worktree failed in $repo"
    fi
    role_cwd="$wt_path"

    # A fresh checkout carries only tracked files, and on these repos the agent's context
    # is deliberately untracked: the backend repository's .gitignore ignores CLAUDE.md, and
    # .claude/ (settings, skills, healthcheck config) is never committed either. So a
    # --worktree hire used to start blind. Measured 11.09.2026 on a smoke run: an agent hired
    # into such a worktree reported "no CLAUDE.md in the repository root" and worked without
    # the project's instructions. Copy the context over, never overwriting what the checkout
    # already has (a repo that tracks its CLAUDE.md keeps the committed one).
    copied=""
    for ctx in CLAUDE.md .claude .mcp.json; do
        if [ -e "$repo/$ctx" ] && [ ! -e "$wt_path/$ctx" ]; then
            cp -R "$repo/$ctx" "$wt_path/$ctx"
            copied="$copied $ctx"
        fi
    done

    echo "worktree $worktree checked out at $wt_path (from $repo)"
    if [ -n "$copied" ]; then
        echo "context copied into the checkout:$copied"
    fi
fi

# --- a pane for the hire: its own tab in the project workspace -----------------
pane=$(herdr tab create --workspace "$ws" --cwd "$role_cwd" --label "$name" --focus | field root_pane pane_id)
[ -n "$pane" ] || die "herdr tab create returned no pane in workspace $ws"

# --- wait until the pane really has a shell ------------------------------------
# `tab create` returns before the shell is up, and `agent start` then fails with
# agent_pane_busy. Keystrokes queue on the pty, so we echo a marker
# and wait for it. The marker must be *assembled by the shell*: the tty driver
# echoes typed characters before the shell even starts, so waiting for text that
# also appears in the command line would match that echo and prove nothing.
# The quotes split the marker in the typed line ("rdyNNN""-ok") but the shell
# concatenates them in the output (rdyNNN-ok), so only real output can match.
#
# The timeout is 120s, not 30s: zsh here loads a full profile, and with two or three agents
# already running the shell regularly took longer than thirty seconds to draw its first
# prompt. Every hire on 2026-08-08 died on that, and the pane was healthy each time — the
# probe simply gave up too early. Keystrokes queue on the pty, so waiting longer costs
# nothing when the shell is fast.
# The comment above is wrong on one point, and it cost every hire on 2026-08-08: text sent
# before the pty exists is **lost**, not queued. Proven on herdr 0.7.5 — a pane that timed
# out on a 120s single wait answered the very same probe in under a second when it was sent
# again a minute later. So the marker has to be **re-sent**, not waited for longer: one lost
# keystroke then costs a step instead of the whole hire.
READY_TIMEOUT="${RECRUIT_READY_TIMEOUT:-120000}"   # total budget
READY_STEP="${RECRUIT_READY_STEP:-8000}"           # per attempt
ready_probe() {
    attempts=$(( READY_TIMEOUT / READY_STEP ))
    [ "$attempts" -lt 1 ] && attempts=1
    i=0
    while [ "$i" -lt "$attempts" ]; do
        i=$((i + 1))
        tag="rdy$$_$1_$i"
        herdr pane send-text "$pane" "echo \"$tag\"\"-ok\"
" >/dev/null 2>&1
        if herdr pane wait-output "$pane" --match "$tag-ok" --timeout "$READY_STEP" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}
ready_probe 0 || die "pane $pane never reached a shell prompt in ${READY_TIMEOUT}ms — look at it with 'herdr pane read $pane'"

# --- launch the agent ---------------------------------------------------------
# `--agent` is native: Claude Code loads the definition, its tool restrictions and
# its model from ~/.claude/agents/<role>.md.
#
# herdr can still report the pane as busy for a moment after the probe command
# exits, so retry. Each retry runs another probe, which both re-confirms the shell
# and gives the server time to settle.
#
# Block for roughly one second by waiting for output that never arrives. A probe
# alone is not enough here: it returns the moment the marker matches, so retrying
# on it burns every attempt within a second and the pane is still settling.
settle() { herdr pane wait-output "$pane" --match "__never_${$}__" --timeout 1200 >/dev/null 2>&1 || true; }

attempt=1
until herdr agent start "$name" --kind "$AGENT_KIND" --pane "$pane" --timeout 180000 \
        -- --agent "$role" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -gt 10 ] && die "pane $pane stayed busy after 10 attempts — check it with 'herdr pane read $pane'"
    settle
    fresh=$(next_name)
    if [ "$fresh" != "$name" ]; then
        # Somebody else took our number while we were waiting.
        name="$fresh"
        herdr pane rename "$pane" "$name" >/dev/null 2>&1 || true
    fi
done
echo "hired $name  role=$role  cwd=$role_cwd  pane=$pane"

[ -n "$task" ] || exit 0

# `agent start` reports readiness before the TUI has drawn its input box, so the
# first prompt can be swallowed. Send it, then confirm the agent actually moved.
before=$(herdr agent get "$name" | field agent state_change_seq)
herdr agent prompt "$name" "$task" >/dev/null
i=0
while [ "$i" -lt 15 ]; do
    after=$(herdr agent get "$name" | field agent state_change_seq)
    [ "$after" != "$before" ] && { echo "task delivered to $name"; exit 0; }
    i=$((i + 1))
done
herdr agent prompt "$name" "$task" >/dev/null
echo "task re-sent to $name (first attempt was swallowed) — check the pane"
